# Optional environment variables for the Agentic OS web server.
# Every variable has a safe default — the app runs with no .env file at
# all, and local mode needs no secrets, API keys, or credentials.
# Hosted deployments may set the database, authentication, and model
# credentials below. Keep every one of them server-side: none is ever
# sent to the browser, and this file must contain placeholders only.

# Comma-separated list of origins allowed to call the API from a browser.
# Only needed when the frontend dev server runs on a non-default port.
AGENTIC_OS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alternative configuration file for the server (used by the e2e tests to
# avoid touching the real data/memory.json).
# AGENTIC_OS_CONFIG=frontend/e2e/.tmp/config.json

# Path to a pre-installed Chromium for Playwright e2e tests, when browser
# downloads are unavailable.
# PLAYWRIGHT_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# Hosted-mode database (server-side ONLY). When set, runs/tasks/approvals/
# artifacts persist to PostgreSQL instead of the local SQLite file. For
# Supabase use the session pooler string from the dashboard (Connect →
# Session pooler), e.g.:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Managed authentication (server-side ONLY). With none of these set the
# app runs in labelled local mode: one local owner, no login. Setting
# AGENTIC_OS_ENV=production or AGENTIC_OS_REQUIRE_AUTH=1 WITHOUT a
# provider makes startup fail closed rather than serve data openly.
# AGENTIC_OS_ENV=production
# Shared-secret tokens (Supabase legacy JWT secret, HS256):
# SUPABASE_JWT_SECRET=your-project-jwt-secret
# or OIDC/JWKS verification (RS256/ES256):
# AGENTIC_OS_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AGENTIC_OS_JWT_AUDIENCE=authenticated
# AGENTIC_OS_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Browser sign-in (publishable values only — safe to expose):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
# Per-caller write rate limit (default 600 per 60s, sized above the
# analytics run engine's own ~3 writes/second cadence):
# AGENTIC_OS_RATE_LIMIT=600
# AGENTIC_OS_RATE_WINDOW=60
# Role for authenticated users whose token carries no role claim:
# AGENTIC_OS_DEFAULT_ROLE=viewer

# Optional narrator. The model only phrases already-verified facts — it
# never sees the dataset and never produces a number. With none of these
# set, a deterministic template is used and the app is fully functional
# offline. All are server-side ONLY: never expose one to the browser, and
# rotate any key that was ever shared in chat.
#
# Priority: ollama > anthropic > groq. Ollama comes first because it is
# the only option where nothing leaves your machine.
#
# 1. Local model via Ollama (no key, no account):
#      ollama serve && ollama pull qwen3:4b
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://127.0.0.1:11434
#    Reasoning models (qwen3, deepseek-r1) think inside <think> tags before
#    answering; that scratchpad is stripped and never reaches a report, and
#    local models get a larger token budget so thinking does not eat the
#    whole reply. Ollama must be reachable from the SERVER: a model on your
#    laptop is not visible to a hosted deployment.
#
# 2. Claude:
# ANTHROPIC_API_KEY=your-rotated-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# 3. Groq:
# GROQ_API_KEY=your-rotated-key-here
# GROQ_MODEL=openai/gpt-oss-120b

# Per-tenant quotas. Defaults (200 runs/day, 100 datasets, 50 MB per
# owner) exist to stop a runaway loop, not to ration ordinary use. A
# malformed value falls back to the default; 0 is honoured as a real stop.
# AGENTIC_OS_QUOTA_RUNS_PER_DAY=200
# AGENTIC_OS_QUOTA_DATASETS=100
# AGENTIC_OS_QUOTA_DATASET_BYTES=50000000

# Optional: choose the narrator per report instead of by the fixed
# priority order above (ADR 0017). Anything with a
# route_single({"query": ...}) -> {"model_name": ...} method works,
# including every router in github.com/ulab-uiuc/LLMRouter. LLMRouter is
# NOT installed by requirements.txt — its routers bring torch and CUDA
# wheels (5.3 GB measured); install it separately if you want them.
# A router that cannot be loaded leaves narration exactly as it was and
# reports the problem in /api/health.
# AGENTIC_OS_ROUTER=llmrouter.models.smallest_llm.router.SmallestLLM
# AGENTIC_OS_ROUTER_CONFIG=router.yaml

# Optional: custom stages (ADR 0020). Comma-separated dotted paths to
# classes with role, title, after and run(ctx); a stage that needs
# options is registered in config.json instead ("stages": [{"path": …,
# "options": {…}}]). AGENTIC_OS_STAGES_PATH makes plain folders
# importable (os.pathsep-separated). A stage that fails to load leaves
# the pipeline as it was and is reported in /api/health and /api/pipelines.
# AGENTIC_OS_STAGES=examples.stages.target_attainment.TargetAttainment
# AGENTIC_OS_STAGES_PATH=./plugins
